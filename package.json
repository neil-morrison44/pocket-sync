{
  "name": "pocket-sync",
  "private": true,
  "version": "7.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint-i18n": "eslint --fix --ext .json --format node_modules/eslint-plugin-i18n-json/formatter.js src/i18n",
    "dead-code": "npx ts-prune"
  },
  "dependencies": {
    "@neil-morrison44/gameboy-emulator": "^1.3.0",
    "@prantlf/jsonlint": "11.7.0",
    "@react-three/csg": "^4.0.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@react-three/postprocessing": "^3.1.3",
    "@react-three/uikit": "^1.0.76",
    "@tauri-apps/api": "2.12.2",
    "@tauri-apps/plugin-clipboard-manager": "2.4.1",
    "@tauri-apps/plugin-dialog": "2.8.1",
    "@tauri-apps/plugin-fs": "2.6.0",
    "@tauri-apps/plugin-http": "2.8.1",
    "@tauri-apps/plugin-log": "2.10.0",
    "@tauri-apps/plugin-opener": "2.7.0",
    "@tauri-apps/plugin-os": "2.4.0",
    "@tauri-apps/plugin-process": "2.4.0",
    "@tauri-apps/plugin-shell": "2.4.1",
    "@tauri-apps/plugin-updater": "2.13.2",
    "@tauri-apps/plugin-window-state": "2.5.0",
    "@types/three": "0.186.0",
    "@zip.js/zip.js": "2.23.0",
    "d3-scale": "^4.0.2",
    "date-fns": "^4.4.0",
    "fast-deep-equal": "^3.1.3",
    "fast-fuzzy": "^1.12.0",
    "html-react-parser": "^5.2.7",
    "i18next": "^26.4.2",
    "i18next-icu": "^2.5.0",
    "jotai": "^2.15.0",
    "jotai-effect": "^2.4.2",
    "jotai-family": "^1.1.0",
    "mdast-util-gfm-autolink-literal": "2.0.0",
    "postprocessing": "^6.39.5",
    "pretty-bytes": "^7.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.16",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "simplex-noise": "^4.0.3",
    "tauri-plugin-locale-api": "^2.0.1",
    "three": "0.186.1",
    "three-stdlib": "^2.36.1",
    "wouter": "^3.13.0"
  },
  "devDependencies": {
    "@octokit/rest": "^22.0.1",
    "@tauri-apps/cli": "^2.12.1",
    "@types/d3-scale": "^4.0.9",
    "@types/jsonlint": "^1.6.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.38.0",
    "eslint-plugin-i18n-json": "^4.0.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "postcss-nesting": "^13.0.2",
    "stylelint": "^16.25.0",
    "stylelint-config-standard": "^39.0.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vite-plugin-i18next-loader": "^4.1.0"
  },
  "prettier": {
    "trailingComma": "es5",
    "tabWidth": 2,
    "semi": false,
    "singleQuote": false
  },
  "eslintConfig": {
    "extends": [
      "eslint:recommended",
      "plugin:@typescript-eslint/recommended",
      "plugin:react/recommended",
      "plugin:react/jsx-runtime",
      "plugin:react-hooks/recommended",
      "plugin:i18n-json/recommended"
    ],
    "parser": "@typescript-eslint/parser",
    "parserOptions": {
      "ecmaFeatures": {
        "jsx": true
      }
    },
    "plugins": [
      "@typescript-eslint",
      "react",
      "unused-imports",
      "i18n-json"
    ],
    "rules": {
      "react/jsx-no-literals": [
        "error",
        {
          "noStrings": true,
          "ignoreProps": true,
          "allowedStrings": [
            ":",
            "_",
            "X",
            "-"
          ]
        }
      ],
      "i18n-json/valid-message-syntax": [
        2,
        {
          "syntax": "icu"
        }
      ],
      "react/no-unknown-property": [
        "off",
        {
          "ignore": [
            "JSX"
          ]
        }
      ],
      "@typescript-eslint/ban-ts-comment": "warn",
      "unused-imports/no-unused-imports": "error",
      "@typescript-eslint/no-unused-vars": [
        "warn",
        {
          "argsIgnorePattern": "^_",
          "varsIgnorePattern": "^_"
        }
      ]
    },
    "root": true,
    "settings": {
      "react": {
        "version": "detect"
      }
    }
  },
  "stylelint": {
    "extends": "stylelint-config-standard"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "esbuild@0.28.2": true
  }
}
